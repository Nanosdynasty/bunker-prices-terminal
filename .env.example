FLASK_SECRET_KEY=replace-with-a-long-random-string
LOCAL_WORKBOOK_ROOT=C:\Users\deepak\OneDrive\onedrivebunker
MAX_WORKBOOK_MB=50

# Required only for true OneDrive / SharePoint cloud sign-in.
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=replace-with-client-secret-value
MS_AUTHORITY=https://login.microsoftonline.com/common

# Local development:
MS_REDIRECT_URI=http://localhost:5050/auth/callback

# Render production example:
# MS_REDIRECT_URI=https://your-render-service.onrender.com/auth/callback

# Azure App Service production example:
# MS_REDIRECT_URI=https://your-azure-app-name.azurewebsites.net/auth/callback
